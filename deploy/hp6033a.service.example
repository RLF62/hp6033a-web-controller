[Unit]
Description=HP 6033A Web Controller
After=network.target

[Service]
Type=simple
User=pi
Group=www-data
WorkingDirectory=/home/pi/hp6033a
RuntimeDirectory=hp6033a
RuntimeDirectoryMode=0750
UMask=0007

ExecStart=/home/pi/hp6033a/venv/bin/gunicorn \
    --workers 1 \
    --bind unix:/run/hp6033a/gunicorn.sock \
    app:app

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
