# XyphroLabs GPIB v2 USB device access
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="03eb", ATTR{idProduct}=="2065", MODE="0660", GROUP="plugdev"

# Linux USBTMC device access
SUBSYSTEM=="usbmisc", KERNEL=="usbtmc[0-9]*", ATTRS{idVendor}=="03eb", ATTRS{idProduct}=="2065", MODE="0660", GROUP="plugdev"
